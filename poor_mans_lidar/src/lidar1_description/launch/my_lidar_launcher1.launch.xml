<launch>

    <let name ="urdf_path" value="$(find-pkg-share lidar1_description)/urdf/robot.urdf.xacro" />
    <let name="rviz_config_path" value="$(find-pkg-share lidar1_description)/rviz/urdf_config.rviz" />
    <let name="gazebo_config_path" value="$(find-pkg-share lidar1_description)/config/lidar1_gazebo.yaml" />


    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description" value="$(command 'xacro $(var urdf_path)')"/>
    </node>

    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="$(find-pkg-share lidar1_description)/worlds/empty_sensor.sdf -r" />
    </include>

    <node pkg="ros_gz_bridge" exec="parameter_bridge">
        <param name="config_file" value="$(var gazebo_config_path)"/>
    </node>

    <node pkg="rviz2" exec="rviz2" args="-d $(var rviz_config_path)">
        <param name="use_sim_time" value="true"/>
    </node>

    <node pkg="ros_gz_sim" exec="create" output="screen" args="--topic robot_description "/>
</launch>